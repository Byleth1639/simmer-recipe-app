# Keep your current connection and exact public origin.
MONGODB_URI=mongodb://127.0.0.1:27017/simmer
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3001

# OpenAI recipe suggestions (server only).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=30

# Cloudinary dashboard credentials (server only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=simmer

# Random owner token: at least 32 characters. Enter it in Photo studio.
ADMIN_TOKEN=
# Separate random token, shared only between this server and the Python service.
SD_SERVICE_TOKEN=
SD_SERVICE_URL=
SD_REQUEST_TIMEOUT_MS=600000
IMAGE_DAILY_LIMIT=5

# Create and save a missing recipe photo automatically on first open.
AUTO_RECIPE_PHOTOS=1
IMAGE_QUEUE_LIMIT=120
IMAGE_RETRY_COOLDOWN_MS=120000
