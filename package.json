{
  "name": "simmer-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix mern/client --",
    "build": "npm run build --prefix mern/client",
    "start": "node mern/server/server.mjs",
    "test": "node --test tests/recipes.test.mjs tests/advanced.test.mjs tests/enhancement-errors.test.mjs tests/recipe-visuals.test.mjs",
    "setup": "npm ci --prefix mern/server && npm ci --prefix mern/client",
    "typecheck": "npm run typecheck --prefix mern/client"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "typescript": "5.9.3",
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1"
  }
}
